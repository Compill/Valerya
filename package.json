  "license": "MIT",
  "scripts": {
    "start": "nx serve demo --port 4230",
    "[DEPLOY] ALL": "node deploy surface core components ui",
    "[DEPLOY] 1 - surface": "node deploy.js surface",
    "[DEPLOY] 2 - core": "node deploy.js core",
    "[DEPLOY] 3 - components": "node deploy.js components",
    "[DEPLOY] 4 - ui": "node deploy.js ui",
    "deploy cli": "cd libs/cli && node deploy.js",
    "deploy react-utils": "node deploy.js react-utils",
    "deploy props-docs": "node deploy.js props-docs",
    "deploy utils": "node deploy.js utils",
    "build": "nx build",
    "[BUILD] ui": "npx nx run ui:build",
    "[BUILD] components": "npx nx run components:build",
    "[BUILD] core": "npx nx run core:build",
    "[BUILD] surface": "npx nx run surface:build",
    "update nx step 1": "nx migrate latest",
    "update nx step 2": "npm install",
    "update nx step 3": "nx migrate --run-migrations",
    "update nx step 4": "rm migrations.json"
  },
